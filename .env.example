# =========================================================
# FOODZ CLOUD DEPLOYMENT CONFIGURATION (.env.example)
# Copy this file to .env for local development.
# On Render / Vercel, add these keys under Environment Variables.
# NEVER commit your actual .env file or real secrets to GitHub!
# =========================================================

# ---------------------------------------------------------
# 1. SERVER CONFIGURATION (Render Web Service)
# ---------------------------------------------------------
# Render automatically provides PORT (usually 10000).
PORT=3000
ENV=production

# Allowed origins for Cross-Origin Resource Sharing (CORS)
# Set to your Vercel URL in production (e.g., https://your-foodz-app.vercel.app)
# or '*' to allow all frontends.
ALLOWED_ORIGINS=*

# ---------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE CONFIGURATION
# ---------------------------------------------------------
# Option A (Recommended): Direct Supabase Connection URI
# Copy from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Note: For free hosting, Supabase requires sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DB_SSLMODE=require

# Option B: Individual Database Parameters (Alternative to DATABASE_URL)
# PGHOST=db.[YOUR-PROJECT-REF].supabase.co
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=your_database_password_here
# PGSSLMODE=require

# In production, set to false so the server never silently falls back to SQLite
ALLOW_SQLITE_FALLBACK=false

# ---------------------------------------------------------
# 3. EMAIL & OTP VERIFICATION CONFIGURATION
# ---------------------------------------------------------
# Method A: Standard SMTP (Gmail, Brevo, SendGrid SMTP)
# For Gmail: Use an App Password (not your personal Gmail password)
# Generate from: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Method B (Recommended for Free Hosting): HTTPS-based Resend API
# Resend (https://resend.com) uses HTTPS port 443 which is never blocked by cloud hosts.
# Free plan includes 3,000 emails/month.
# RESEND_API_KEY=re_123456789abcdef
# EMAIL_FROM=Foodz <onboarding@resend.dev>

# ---------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Vercel)
# ---------------------------------------------------------
# Your deployed Render backend URL (no trailing slash).
# Used by frontend/config.js and vercel.json rewrite rules.
# FOODZ_API_BASE_URL=https://foodz-backend.onrender.com
